# Copy to .env.build and replace the example hosts before a production build.
# NEXT_PUBLIC_* values are public and are embedded in the browser bundle.
# Use browser-reachable URLs here, never Docker-only service/container hostnames.
NEXT_PUBLIC_API_URL=https://todo-api.example.com/api
NEXT_PUBLIC_SOCKET_URL=https://todo-api.example.com
NEXT_PUBLIC_SOCKET_PATH=/api/socket.io/
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.example.com
